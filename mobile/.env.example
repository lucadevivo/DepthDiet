# Copia in `.env`. Solo config PUBBLICA (prefisso EXPO_PUBLIC_): niente segreti qui.
# I segreti (bearer token, Cloudflare service token) stanno in expo-secure-store.

# URL del backend. In dev su device fisico usa l'IP LAN del PC o il sottodominio del tunnel.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8787
