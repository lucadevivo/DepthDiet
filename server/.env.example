# Copia in `.env` e compila. NON committare il .env reale (è in .gitignore).

# Porta locale del backend (dietro il Cloudflare Tunnel).
PORT=8787
NODE_ENV=development

# --- Fase 1b: database & backup ---
# Percorso del file SQLite (in Docker/systemd punta a un volume persistente).
DATABASE_PATH=data/food-tracker.sqlite
# Cartella dei backup e quanti tenerne.
BACKUP_DIR=backups
BACKUP_RETENTION=14

# --- Fase 1c: sicurezza ---
# Livello 2 — token bearer applicativo: l'app lo manda in `Authorization: Bearer <token>`.
# Genera con: openssl rand -hex 32
# Se vuoto, le rotte protette rispondono 401 (fail-closed).
APP_BEARER_TOKEN=

# Livello 1 (opzionale) — verifica del JWT di Cloudflare Access lato backend.
# Valorizza ENTRAMBI per attivarla; lasciali vuoti in dev locale.
# CF_ACCESS_TEAM_DOMAIN=https://mioteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# --- Fase 1d: Gemini ---
# Chiave API Gemini (free tier, da Google AI Studio). Vive SOLO qui sul backend.
GEMINI_API_KEY=
# Modello multimodale. Default verificato sul free tier (giu 2026): gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
