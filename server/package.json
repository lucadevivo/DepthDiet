{
  "name": "food-tracker-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend single-user per app di tracking alimentare (Express + TS + SQLite + Gemini)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:backup": "tsx src/scripts/backup.ts",
    "gemini:test": "tsx src/scripts/test-analyze.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.9.0",
    "express": "^5.1.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
